# Weather API Configuration (Optional)
# The app uses the Open-Meteo API by default, which is free and needs no API key.
# These variables are placeholders for future API integrations.

VITE_WEATHER_API_KEY=
VITE_AQI_API_KEY=

# Weather snapshot sync (optional).
# With a token, the built site commits today's snapshot to the repository on load
# (see src/services/githubSync.ts). The value is compiled into the public bundle,
# so use a fine-grained token scoped to one repository with 'Contents: read and
# write' — nothing else — and treat it as public. Copy this file to .env.local to
# use it locally; on GitHub Pages the same value comes from the WEATHER_SYNC_TOKEN
# repository secret.
VITE_GITHUB_TOKEN=
VITE_GITHUB_BRANCH=master
# Overrides repository detection (owner/name); normally left empty.
VITE_GITHUB_REPO=

# Base path for the built site.
# Leave empty (or '/') for local preview and root-domain hosting.
# Set to '/<repo-name>/' when deploying to a GitHub Pages project site.
VITE_BASE_PATH=
